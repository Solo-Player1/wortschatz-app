  "grammar": [
    {
      "id": "g58-1",
      "h": "welcher؟ welche؟ welches؟ = أنهي؟ (مراجعة)",
      "body": "welch- = أنهي، بنسأل بيها لما نختار حاجة معيّنة من كذا حاجة (أنهي لون؟ أنهي بلوفر؟). بتيجي قبل الاسم على طول، وآخرها زي آخر أداة التعريف بالظبط: der يبقى welcher، die يبقى welche، das يبقى welches، والجمع welche. وفي النصب (Akkusativ) المذكّر بس اللي بيتغيّر، زي den بالظبط: welchen. الباقي زي ما هو.",
      "examples": [
        {
          "de": "Welche Farbe magst du am liebsten?",
          "ar": "بتحب أنهي لون أكتر حاجة؟"
        },
        {
          "de": "Welcher Schal ist am schönsten?",
          "ar": "أنهي شال أحلى واحد؟"
        },
        {
          "de": "Welchen Pullover ziehst du heute an?",
          "ar": "هتلبس أنهي بلوفر النهارده؟"
        }
