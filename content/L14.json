  "grammar": [
    {
      "id": "g14-1",
      "h": "جنس الأسماء: der / die / das",
      "body": "كل اسم في الألماني ليه أداة بتقول جنسه: der مذكّر، die مؤنّث، das محايد. مفيش قاعدة عامة، والجنس مش زي العربي (die Milch مؤنّث بس das Wasser محايد). عشان كده ماتحفظش الكلمة لوحدها أبدًا: احفظ der Kaffee مش Kaffee.",
      "examples": [
        {
          "de": "Der Kaffee ist sehr gut.",
          "ar": "القهوة حلوة أوي."
        },
        {
          "de": "Die Limonade ist für Nina.",
          "ar": "الليموناضة لنينا."
        },
        {
          "de": "Das Wasser ist im Kühlschrank.",
          "ar": "المية في التلاجة."
        }
      ],
      "table": [
        [
          "der (مذكّر)",
          "die (مؤنّث)",
          "das (محايد)"
        ],
        [
