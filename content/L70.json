  "grammar": [
    {
      "id": "g70-1",
      "h": "dürfen = مسموح",
      "body": "dürfen معناه «مسموح». بنستخدمه لما حد عنده سلطة يسمح بحاجة: الدكتور، الأهل، القانون. وتصريفه ماشي زي können و müssen: في المفرد الـ ü بتبقى a (ich darf، du darfst)، و ich و er / sie / es / man نفس الشكل ومن غير نهاية: ich darf، man darf. وفي الجمع الـ ü بترجع: wir dürfen، ihr dürft، sie / Sie dürfen.",
      "examples": [
        {
          "de": "Sie dürfen Wasser oder Tee trinken.",
          "ar": "حضرتك مسموحلك تشرب مية أو شاي."
        },
        {
          "de": "Darf ich wieder Sport machen?",
          "ar": "مسموحلي أرجع ألعب رياضة؟"
        },
        {
          "de": "Im Wartezimmer dürft ihr nur leise sprechen.",
          "ar": "في أوضة الانتظار مسموحلكم تتكلموا بصوت واطي بس."
        }
      ],
      "table": [
        [
