  "grammar": [
    {
      "id": "g59-1",
      "h": "أفعال مع Dativ: gefallen، passen، stehen",
      "body": "فيه أفعال المفعول بتاعها بييجي في حالة الجر (Dativ)، وغالبًا بيبقى شخص: gefallen (يعجب)، passen (ييجي على المقاس)، stehen (يليق على). خد بالك: الهدوم هي الفاعل، فالفعل بيتصرّف معاها هي: Die Jacke steht dir، ومع الجمع: Die Schuhe passen mir. والشخص بيبقى mir / dir مش ich / du. وفي gefallen الـ a بتبقى ä مع du و er / sie / es: du gefällst، das gefällt.",
      "examples": [
        {
          "de": "Das Hemd gefällt mir.",
          "ar": "القميص عاجبني."
        },
        {
          "de": "Ja, die Jacke steht dir sehr gut.",
          "ar": "أيوه، الجاكيت لايق عليك أوي."
        },
        {
          "de": "Die Schuhe passen mir nicht.",
          "ar": "الجزمة مش مقاسي."
        }
      ],
      "table": [
        [
          "الفعل",
          "حاجة واحدة",
          "جمع"
        ],
        [
          "gefallen (يعجب)",
          "Das Hemd gefällt mir.",
          "Die Schuhe gefallen mir."
        ],
        [
          "passen (مقاسه مظبوط)",
          "Die Hose passt mir.",
          "Die Hosen passen mir."
        ],
        [
          "stehen (لايق على)",
          "Die Jacke steht dir.",
          "Die Jacken stehen dir."
        ]
      ]
    },
    {
      "id": "g59-2",
      "h": "الشخص في Dativ: mir، dir، dem، der، den",
      "body": "الشخص مع gefallen و passen و stehen بييجي في Dativ، والأداة بتتغيّر زي درس 39: der و das بيبقوا dem، و die بتبقى der، والجمع den والاسم بياخد n زيادة (den Kindern). والنكرة: einem / einer. والضماير: ich بتبقى mir، و du بتبقى dir، و Sie بتبقى Ihnen. وبنسأل عن الشخص بـ Wem? (لمين؟): Wem passt das Hemd nicht? – Dem Mann.",
