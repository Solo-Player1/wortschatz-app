  "grammar": [
    {
      "id": "g44-1",
      "h": "Wo? ولا Wohin؟ — Dativ ولا Akkusativ",
      "body": "حروف الجر التسعة (in، an، auf، über، unter، vor، hinter، neben، zwischen) اسمها «متغيّرة الحالة» عشان ليها حالتين: لو السؤال Wo? (فين؟) والحاجة ثابتة في مكانها، الاسم بعدها بيبقى Dativ. ولو السؤال Wohin? (على فين؟) وفيه حركة لمكان، الاسم بيبقى Akkusativ. و hängen بينفع في الاتنين: Der Kalender hängt an der Wand. (ثابتة) – Ich hänge den Kalender an die Wand. (حركة)",
      "examples": [
        {
          "de": "Das Papier ist im Schrank.",
          "ar": "الورق في الدولاب. (Wo? يعني Dativ)"
        },
        {
          "de": "Die Stifte sind neben der Tastatur.",
          "ar": "الأقلام جنب الكيبورد. (Wo? يعني Dativ)"
        },
        {
          "de": "Ich hänge den Kalender an die Wand.",
          "ar": "بعلّق النتيجة على الحيطة. (Wohin? يعني Akkusativ)"
        },
        {
          "de": "Lisa geht in die Touristeninformation.",
          "ar": "ليزا رايحة مكتب الاستعلامات السياحية. (Wohin? يعني Akkusativ)"
        }
      ],
      "table": [
