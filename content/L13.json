  "grammar": [
    {
      "id": "g13-1",
      "h": "سؤال ja / nein: الفعل في الأول",
      "body": "لو السؤال مالوش أداة استفهام والرد عليه ja أو nein، بنبدأ بالفعل وبعده الفاعل: Kommst du aus Deutschland? – Ja, … / Nein, … أما سؤال الـ W فالأداة الأول والفعل تاني: Woher kommst du?",
      "examples": [
        {
          "de": "Kommst du aus Deutschland? – Ja, ich komme aus Deutschland.",
          "ar": "إنت من ألمانيا؟ – أيوه، أنا من ألمانيا."
        },
        {
          "de": "Wie alt bist du? – Ich bin 22 Jahre alt.",
          "ar": "عندك كام سنة؟ – عندي 22 سنة."
        }
      ],
      "table": [
        [
          "نوع السؤال",
          "1",
