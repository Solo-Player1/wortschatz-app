  "grammar": [
    {
      "id": "g07-1",
      "h": "تصريف الفعل: جذر + نهاية",
      "body": "الفعل في المصدر بيخلص بـ -en: kommen. شيل -en يفضل الجذر komm، وزوّد النهاية حسب الضمير: ich ← -e، du ← -st، Sie (رسمي) ← -en. ونفس الطريقة مع wohnen و lernen و machen: ich wohne، du wohnst، Sie wohnen.",
      "examples": [
        { "de": "Woher kommst du?", "ar": "إنت منين؟" },
        { "de": "Woher kommen Sie?", "ar": "حضرتك منين؟ (رسمي)" },
        { "de": "Ich komme aus Ägypten.", "ar": "أنا من مصر." }
      ],
      "table": [["الضمير", "kommen", "wohnen", "machen"], ["ich", "komme", "wohne", "mache"], ["du", "kommst", "wohnst", "machst"], ["Sie (رسمي)", "kommen", "wohnen", "machen"]]
    },
    {
      "id": "g07-2",
      "h": "heißen و sprechen: خلي بالك",
      "body": "لو الجذر آخره s أو ß أو z أو x، مع du بتزوّد -t بس: du heißt (مش heißst). وفيه أفعال شقية زي sprechen: مع du الـ e بتبقى i ← du sprichst، لكن ich spreche و Sie sprechen عادي.",
      "examples": [
        { "de": "Wie heißt du?", "ar": "اسمك إيه؟" },
        { "de": "Sprichst du Deutsch?", "ar": "بتتكلم ألماني؟" },
        { "de": "Sie sprechen gut Deutsch.", "ar": "حضرتك بتتكلم ألماني كويس. (رسمي)" }
      ],
      "table": [["الضمير", "heißen", "sprechen"], ["ich", "heiße", "spreche"], ["du", "heißt", "sprichst"], ["Sie (رسمي)", "heißen", "sprechen"]]
    },
    {
      "id": "g07-3",
      "h": "sein شاذ",
      "body": "الفعل sein (يكون) مالوش قاعدة، بيتحفظ زي ما هو: ich bin، du bist، Sie sind. في العربي بنقول «أنا نيكو» من غير فعل، لكن في الألماني لازم الفعل: Ich bin Nico. / Sind Sie Tourist?",
      "examples": [
        { "de": "Und wer bist du?", "ar": "وإنت مين؟" },
        { "de": "Entschuldigung, sind Sie Tourist?", "ar": "لو سمحت، حضرتك سايح؟" }
      ],
      "table": [["الضمير", "sein"], ["ich", "bin"], ["du", "bist"], ["Sie (رسمي)", "sind"]]
    },
    {
      "id": "g07-4",
      "h": "woher + aus و wo + in",
      "body": "woher = منين (المكان اللي إنت جاي منه) والرد بـ aus: Ich komme aus Spanien. wo = فين (المكان اللي إنت فيه) والرد بـ in: Ich wohne in Sevilla. ما تخلطش بينهم: الـ -her في woher معناها «جاي من».",
      "examples": [
        { "de": "Woher kommst du? – Ich komme aus Ägypten.", "ar": "إنت منين؟ – أنا من مصر." },
        { "de": "Wo wohnst du? – Ich wohne in Kairo.", "ar": "ساكن فين؟ – ساكن في القاهرة." }
      ],
