  "grammar": [
    {
      "id": "g42-1",
      "h": "Wo? ولا Wohin؟ — جر ولا نصب",
      "body": "حروف الجر in، an، auf، über، unter، vor، hinter، neben، zwischen حالتها بتتغيّر حسب السؤال. Wo? (فين؟ = مكان ثابت، زي مع sein): الاسم بعدها في حالة الجر (Dativ): im Zentrum، an der Ampel. Wohin? (رايح فين؟ = حركة لمكان، زي مع gehen و biegen): الاسم في حالة النصب (Akkusativ): in die Krugstraße، über den Grafenplatz. وخد بالك: in + dem = im، in + das = ins، an + dem = am.",
      "examples": [
        {
          "de": "Wo seid ihr? – Wir sind im Park.",
          "ar": "إنتوا فين؟ – إحنا في الجنينة."
        },
        {
          "de": "Wohin geht ihr? – Wir gehen in den Park.",
          "ar": "رايحين فين؟ – رايحين الجنينة."
        },
        {
          "de": "Auf der Autobahn ist Stau.",
          "ar": "فيه زحمة على الطريق السريع. (Wo? يعني جر: der)"
        },
        {
          "de": "Biegen Sie dann links in die Krugstraße.",
          "ar": "بعدين لف شمال في شارع كروج. (Wohin? يعني نصب: die)"
        }
      ],
      "table": [
        [
          "",
