  "grammar": [
    {
      "id": "g06-1",
      "h": "تعرّف حد: Das ist … و er / sie",
      "body": "عشان تعرّف حد على حد تاني قول: Das ist + الاسم. das هنا معناها «ده / دي» ومش بتتغير مع الراجل أو الست. ولو هتكمّل كلام عن نفس الشخص: er = هو، sie = هي، والفعل معاهم بيخلص بـ -t: er heißt، sie kommt. أما sein فشاذ: er ist / sie ist.",
      "examples": [
        { "de": "Das ist Nico.", "ar": "ده نيكو." },
        { "de": "Das ist Herr Weber. Er ist Taxifahrer.", "ar": "ده أستاذ فيبر. هو سوّاق تاكسي." },
        { "de": "Er heißt Nico und kommt aus Spanien.", "ar": "اسمه نيكو وهو من إسبانيا." }
      ],
      "table": [["الفعل", "er (هو)", "sie (هي)"], ["sein", "er ist", "sie ist"], ["heißen", "er heißt", "sie heißt"], ["kommen", "er kommt", "sie kommt"]]
    },
    {
      "id": "g06-2",
      "h": "المهنة من غير أداة",
      "body": "في الألماني بتقول المهنة على طول من غير ein: Er ist Taxifahrer. (مش Er ist ein Taxifahrer). ولو ست بنزوّد -in في آخر الكلمة: Taxifahrer ← Taxifahrerin، Deutschlehrer ← Deutschlehrerin، Student ← Studentin.",
      "examples": [
        { "de": "Er ist Taxifahrer.", "ar": "هو سوّاق تاكسي." },
        { "de": "Sie ist Taxifahrerin.", "ar": "هي سوّاقة تاكسي." },
        { "de": "Nein, sie ist Deutschlehrerin.", "ar": "لأ، هي مدرّسة ألماني." }
      ],
      "table": [["مذكّر", "مؤنّث", "المعنى"], ["der Taxifahrer", "die Taxifahrerin", "سوّاق / سوّاقة تاكسي"], ["der Deutschlehrer", "die Deutschlehrerin", "مدرّس / مدرّسة ألماني"], ["der Student", "die Studentin", "طالب / طالبة"]]
    },
    {
      "id": "g06-3",
      "h": "Vorname و Familienname",
      "body": "في أي استمارة في ألمانيا هتلاقي der Vorname (اسمك الأول) و der Familienname (اسم العيلة). السؤال الرسمي: Wie ist Ihr Vorname? / Wie ist Ihr Familienname? والرد: Mein Vorname ist … / Mein Familienname ist … ومع صاحبك بتقول: Wie ist dein Vorname?",
      "examples": [
        { "de": "Mein Vorname ist Nico.", "ar": "اسمي الأول نيكو." },
        { "de": "Wie ist Ihr Familienname?", "ar": "اسم عيلة حضرتك إيه؟ (رسمي)" }
      ],
      "table": [["الكلمة", "معناها", "مثال"], ["der Vorname", "الاسم الأول", "Nico"], ["der Familienname", "اسم العيلة", "González"]]
    },
    {
      "id": "g06-4",
      "h": "lernen منتظم و helfen شقي",
      "body": "lernen ماشي على القاعدة: ich lerne، du lernst، er lernt، wir lernen. لكن helfen شقي: مع du و er/sie الـ e بتبقى i ← du hilfst، er hilft. والشخص اللي بتساعده بييجي بعده mir / dir: Hilfst du mir? = هتساعدني؟",
