  "grammar": [
    {
      "id": "g32-1",
      "h": "zuerst، dann، danach: الترتيب",
      "body": "عشان تحكي حاجات بتحصل ورا بعض بالترتيب: zuerst = الأول، dann = بعدين، danach = بعد كده. dann و danach معناهم واحد بالظبط، قول أي واحدة فيهم. وممكن تكرر dann أكتر من مرة زي نيكو في الحلقة: Zuerst machen wir die Hausaufgaben, dann räumen wir auf und dann sehen wir fern.",
      "examples": [
        {
          "de": "Zuerst sehen Nico und Emma fern.",
          "ar": "الأول نيكو وإيما بيتفرجوا على التلفزيون."
        },
        {
          "de": "Dann essen Nico und Emma Eis.",
          "ar": "بعدين نيكو وإيما بياكلوا آيس كريم."
        },
        {
          "de": "Danach spielen sie zusammen.",
          "ar": "بعد كده بيلعبوا مع بعض."
        }
      ],
      "table": [
